# registry.npmjs.org has proven slow/unreliable to reach from the deploy
# server's network. This mirror is a full, reliable read-through mirror of
# the npm registry (formerly the Taobao npm mirror) and is generally much
# more stable to reach from restricted networks. Same packages, different
# download source.
registry=https://registry.npmmirror.com/

fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
audit=false
fund=false
