# Password required to open the ssh-console UI itself (the "front door").
# Required in any real deployment - without it the app is open to anyone
# who can reach the URL.
APP_PASSWORD=change-me

# Secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# Keep this stable across restarts/redeploys so sessions aren't invalidated.
APP_SECRET=change-me-too

# Port the Node server listens on inside the container.
PORT=3000
